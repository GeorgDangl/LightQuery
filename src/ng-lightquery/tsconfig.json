{
  "compileOnSave": false,
  "compilerOptions": {
    "outDir": "./dist/out-tsc",
    "sourceMap": true,
    "esModuleInterop": true,
    "declaration": false,
    "experimentalDecorators": true,
    "module": "es2022",
    "moduleResolution": "bundler",
    "strict": false,
    "importHelpers": true,
    "target": "ES2022",
    "lib": [
      "es2022",
      "dom"
    ],
    "paths": {
      "ng-lightquery": [
        "./dist/ng-lightquery"
      ]
    },
    "useDefineForClassFields": false
  },
  "angularCompilerOptions": {
    "fullTemplateTypeCheck": true,
    "strictTemplates": false,
    "strictInjectionParameters": true
  }
}