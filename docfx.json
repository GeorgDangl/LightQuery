{
  "metadata":[
	{
      "src": [
        {
          "files": ["LightQuery.csproj"],
          "exclude": [ "**/bin/**", "**/obj/**" ],
          "src": "./src/LightQuery"
        }
      ],
      "dest": "lightquery"
    },
	{
      "src": [
        {
          "files": ["LightQuery.Client.csproj"],
          "exclude": [ "**/bin/**", "**/obj/**" ],
          "src": "./src/LightQuery.Client"
        }
      ],
      "dest": "client"
    },
	{
      "src": [
        {
          "files": ["LightQuery.Shared.csproj"],
          "exclude": [ "**/bin/**", "**/obj/**" ],
          "src": "./src/LightQuery.Shared"
        }
      ],
      "dest": "shared"
    },
	{
      "src": [
        {
          "files": ["LightQuery.EntityFrameworkCore.csproj"],
          "exclude": [ "**/bin/**", "**/obj/**" ],
          "src": "./src/LightQuery.EntityFrameworkCore"
        }
      ],
      "dest": "efcore"
    },
    {
      "src": [
        {
          "files": [
            "LightQuery.csproj"
          ],
          "exclude": [
            "**/bin/**",
            "**/obj/**"
          ],
          "src": "./src/LightQuery"
        }
      ],
      "dest": "output/docs-markdown/lightquery",
      "outputFormat": "markdown"
    },
    {
      "src": [
        {
          "files": [
            "LightQuery.Client.csproj"
          ],
          "exclude": [
            "**/bin/**",
            "**/obj/**"
          ],
          "src": "./src/LightQuery.Client"
        }
      ],
      "dest": "output/docs-markdown/client",
      "outputFormat": "markdown"
    },
    {
      "src": [
        {
          "files": [
            "LightQuery.Shared.csproj"
          ],
          "exclude": [
            "**/bin/**",
            "**/obj/**"
          ],
          "src": "./src/LightQuery.Shared"
        }
      ],
      "dest": "output/docs-markdown/shared",
      "outputFormat": "markdown"
    },
    {
      "src": [
        {
          "files": [
            "LightQuery.EntityFrameworkCore.csproj"
          ],
          "exclude": [
            "**/bin/**",
            "**/obj/**"
          ],
          "src": "./src/LightQuery.EntityFrameworkCore"
        }
      ],
      "dest": "output/docs-markdown/efcore",
      "outputFormat": "markdown"
    }
  ],
  "build":{
    "content":[
      {
        "files":[
          "*.md",
          "**/*.yml"
        ],
        "exclude": [
          "output/**/*",
          "docs/**/*",
          "GitVersion.yml",
          "src/ng-lightquery/**/*"
        ]
      }
    ],
    "resource":[
      {
        "files":[
          "**.png",
          "**.ts"
        ]
      }
    ],
    "overwrite":"specs/*.md",
    "globalMetadata":{
      "_appTitle":"LightQuery Documentation",
      "_appFooter":"&copy; <a href=\"https://www.dangl-it.com\" target=\"_blank\">Georg Dangl</a>",
      "_appLogoPath":"app-logo.png",
      "_appFaviconPath":"app-logo.png",
      "_enableSearch":true,
      "_gitUrlPattern": "github"
    },
    "dest":"./output/docs",
    "template": [
      "default",
      "docs/template"
    ]
  }
}
